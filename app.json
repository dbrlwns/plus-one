{
  "expo": {
    "name": "+1",
    "slug": "plus-one",
    "scheme": "plusone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plusone.homefitness"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1013",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.plusone.homefitness"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F7",
          "image": "./assets/splash-logo-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E1013",
            "image": "./assets/splash-logo-dark.png"
          },
          "ios": {
            "image": "./assets/splash-ios-light.png",
            "dark": {
              "image": "./assets/splash-ios-dark.png"
            }
          }
        }
      ]
    ]
  }
}
